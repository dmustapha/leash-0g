{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test test-live",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.12",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.5",
    "@privy-io/server-auth": "^1.32.5",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "eciesjs": "^0.4.11",
    "ethers": "^6.13.1",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "nock": "^14.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
