{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["mr_iid", "head_sha", "rounds", "verdict", "prev_hash", "entry_hash", "created_at"],
  "additionalProperties": false,
  "properties": {
    "mr_iid": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "proposer", "skeptic", "objections"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "proposer": { "type": "string" },
          "skeptic": { "type": "string" },
          "objections": { "type": "array" }
        }
      }
    },
    "verdict": { "enum": ["AGREE", "NO_AGREE"] },
    "prev_hash": { "type": "string" },
    "entry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
