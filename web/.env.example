# File: web/.env.example — NEXT_PUBLIC_* vars read by web/lib/config.ts (inlined at build; no secrets).

# Privy app id for owner-wallet login (dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Base URL of the Phase-1 backend API
NEXT_PUBLIC_API_URL=http://localhost:8080

# 0G Galileo testnet JSON-RPC endpoint
NEXT_PUBLIC_ZERO_G_RPC=https://evmrpc-testnet.0g.ai

# 0G Galileo chain id (also binds the audit-key KEK sign message)
NEXT_PUBLIC_ZERO_G_CHAIN_ID=16602

# Deployed AgentRegistry contract address
NEXT_PUBLIC_AGENT_REGISTRY_ADDR=0x0000000000000000000000000000000000000000

# Deployed LeashFactory contract address
NEXT_PUBLIC_LEASH_FACTORY_ADDR=0x0000000000000000000000000000000000000000

# Playwright only: 1 = throwaway local key instead of Privy login (never set in real deploys)
NEXT_PUBLIC_E2E_MODE=
